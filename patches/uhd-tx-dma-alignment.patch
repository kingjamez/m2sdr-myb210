     {
 
-        _lut->length = int((_is_recv) ? _frame_size : size()); // always set length
+        size_t transfer_bytes = _is_recv ? _frame_size : size();
+        // On MyB210 the vendor PCIe backend divides the transfer byte count
+        // by eight before both the DMA-buffer copy and descriptor submission.
+        // Pad B200 data OUT (endpoint 2), leaving the CHDR length untouched.
+        constexpr size_t dma_word_bytes = 8;
+        constexpr unsigned char b200_data_out = 2;
+        if (!_is_recv && _lut->endpoint == b200_data_out &&
+            transfer_bytes % dma_word_bytes != 0) {
+            const size_t padding = dma_word_bytes - transfer_bytes % dma_word_bytes;
+            UHD_ASSERT_THROW(transfer_bytes <= _frame_size);
+            UHD_ASSERT_THROW(padding <= _frame_size - transfer_bytes);
+            std::memset(_lut->buffer + transfer_bytes, 0, padding);
+            transfer_bytes += padding;
+        }
+        _lut->length = static_cast<int>(transfer_bytes);
  
         
 
